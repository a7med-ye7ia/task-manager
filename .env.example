# ==============================================================================
# Task Management System - Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskmanagesys
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Secret (HS256 requires minimum 256-bit secret key)
JWT_SECRET=supersecretjwtkeythatisatleast256bitslongfortaskmanagementsystem2026

# Email / Mail catcher (disabled by default; enable only in production)
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Task Management System
MAIL_REPLY_TO=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_CONNECTION_TIMEOUT=10000
MAIL_READ_TIMEOUT=10000
MAIL_WRITE_TIMEOUT=10000

# Application URL & Storage
APP_BASE_URL=http://localhost:5173
UPLOAD_DIR=./uploads
SERVER_PORT=8080
COOKIE_SECURE=true
ARCHIVE_CRON=0 0 2 * * *
ARCHIVE_ZONE=Africa/Cairo

# Seed Manager Credentials (Created on first run if users table is empty)
# Password must meet BR-40: 8-64 chars, 1 uppercase, 1 lowercase, 1 digit
# Email must be a Gmail address (BR-40)
SEED_MANAGER_FIRST_NAME=System
SEED_MANAGER_LAST_NAME=Manager
SEED_MANAGER_EMAIL=manager@gmail.com
SEED_MANAGER_PASSWORD=Manager123!
SEED_MANAGER_PHONE=+201000000000
